{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PolicyResource",
  "title": "PolicyResource",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "policy"
        },
        "id": {
          "type": "string",
          "description": "Policy name"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "policy": {
              "type": "object",
              "properties": {
                "policyName": {
                  "type": "string"
                },
                "policyType": {
                  "type": "string"
                },
                "policyAttributes": {
                  "$ref": "#/components/schemas/PolicyAttributes"
                },
                "clients": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PolicyClient"
                  }
                },
                "schedules": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PolicySchedule"
                  }
                },
                "backupSelections": {
                  "type": "object",
                  "properties": {
                    "selections": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "links": {
          "type": "object",
          "properties": {
            "self": {
              "type": "object",
              "properties": {
                "href": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      },
      "example": "example_value"
    }
  }
}