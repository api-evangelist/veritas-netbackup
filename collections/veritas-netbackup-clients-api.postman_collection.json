      "item": [
        {
          "id": "3030237a-10df-4400-a548-3f87d6c17e46",
          "name": "Veritas Netbackup List Netbackup Clients",
          "request": {
            "name": "Veritas Netbackup List Netbackup Clients",
            "description": {
              "content": "Returns a list of hosts registered with the NetBackup primary server, including backup clients, media servers, and other host types. Results can be filtered by host name and host type.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "config",
                "hosts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page[limit]",
                  "value": "10",
                  "description": "Maximum number of clients to return"
                },
                {
                  "disabled": false,
                  "key": "page[offset]",
                  "value": "0",
                  "description": "Number of entries to skip for pagination"
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "OData-style filter expression. Supported fields include hostName and hostType. Example: hostType eq 'CLIENT'"
                }
              ],
              "variable": [
                {
                  "description": "Hostname or IP address of the NetBackup primary server",
                  "type": "any",
                  "value": "{{primaryServer}}",
                  "key": "primaryServer"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.netbackup+json;version=4.0"
              }
            ],
            "method": "GET",
            "auth": null
