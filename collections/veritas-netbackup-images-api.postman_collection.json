    {
      "id": "b4b09644-d587-4a61-ad7f-83d39513ea91",
      "name": "Images",
      "description": {
        "content": "Query the NetBackup image catalog to retrieve backup image metadata, search for images by policy or client, and manage image lifecycle operations such as expiration and duplication.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6e0b0244-53ed-446b-9ecb-902f47e7f779",
          "name": "Veritas Netbackup List Backup Images",
          "request": {
            "name": "Veritas Netbackup List Backup Images",
            "description": {
              "content": "Returns a list of backup images in the NetBackup catalog. Images represent completed backup operations and contain metadata about the backup including policy, client, schedule, backup time, size, and expiration. Results can be filtered by policy name, client name, and backup time range.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "catalog",
                "images"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page[limit]",
                  "value": "10",
                  "description": "Maximum number of images to return"
                },
                {
                  "disabled": false,
                  "key": "page[offset]",
                  "value": "0",
                  "description": "Number of images to skip for pagination"
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "OData-style filter expression. Supported fields include policyName, clientName, scheduleName, backupId, and backupTime. Example: policyName eq 'daily-backup' and clientName eq 'server1'"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Comma-separated list of fields to sort by. Prefix with a hyphen for descending order. Example: -backupTime"
                }
              ],
              "variable": [
                {
                  "description": "Hostname or IP address of the NetBackup primary server",
                  "type": "any",
                  "value": "{{primaryServer}}",
                  "key": "primaryServer"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.netbackup+json;version=4.0"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
