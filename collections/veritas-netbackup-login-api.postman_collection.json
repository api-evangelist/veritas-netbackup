          "id": "558e98d7-d945-4c01-8f7a-24db6dc2ae99",
          "name": "Veritas Netbackup Authenticate and Obtain a Jwt",
          "request": {
            "name": "Veritas Netbackup Authenticate and Obtain a Jwt",
            "description": {
              "content": "Authenticates a user against the NetBackup primary server and returns a JSON Web Token (JWT) used to authorize subsequent API calls. The token must be included in the Authorization header as a Bearer token for all other API requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Hostname or IP address of the NetBackup primary server",
                  "type": "any",
                  "value": "{{primaryServer}}",
                  "key": "primaryServer"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/vnd.netbackup+json;version=1.0"
              },
              {
                "key": "Accept",
                "value": "application/vnd.netbackup+json;version=1.0"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domainName\": \"<string>\",\n  \"domainType\": \"<string>\",\n  \"userName\": \"<string>\",\n  \"password\": \"<password>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
